{
  "@context": {
    "prov": "http://www.w3.org/ns/prov#",
    "oa": "http://www.w3.org/ns/oa#",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "schema": "http://schema.org/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "pplan": "http://purl.org/net/p-plan#",
    "grits": "https://w3id.org/grits/",
    "plan": {"@id": "grits:plan", "@type": "@id"},
    "used": {"@id": "prov:used", "@type": "@id", "@container": "@list"},
    "generated": {"@id": "prov:generated", "@type": "@id", "@container": "@list"},
    "agent": {"@id": "prov:wasAttributedTo"},
    "performed_by": {"@id": "prov:wasAssociatedWith"},
    "source": {"@id": "prov:hadPrimarySource"},
    "target": {"@id": "oa:hasTarget"},
    "hasSource": {"@id": "oa:hasSource", "@type": "@id"},
    "selector": {"@id": "oa:hasSelector"},
    "exact": {"@id": "oa:exact"},
    "prefix": {"@id": "oa:prefix"},
    "suffix": {"@id": "oa:suffix"},
    "start": {"@id": "oa:start", "@type": "xsd:nonNegativeInteger"},
    "end": {"@id": "oa:end", "@type": "xsd:nonNegativeInteger"},
    "conformsTo": {"@id": "dcterms:conformsTo", "@type": "@id"},
    "value": {"@id": "rdf:value"},
    "summary": {"@id": "dcterms:description"},
    "name": {"@id": "schema:name"},
    "how": {"@id": "grits:how"},
    "kind": {"@id": "grits:kind"},
    "rationale": {"@id": "grits:rationale"},
    "result": {"@id": "grits:result"},
    "payload": {"@id": "grits:payloadSchema", "@type": "@id"},
    "payload_ref": {"@id": "grits:payloadRef"},
    "content_hash": {"@id": "grits:contentHash"},
    "prompt_digest": {"@id": "grits:promptDigest"},
    "schema_digest": {"@id": "grits:schemaDigest"},
    "uri": {"@id": "@id"},
    "sha256": {"@id": "grits:sha256"},
    "media_type": {"@id": "dcterms:format"},
    "plan_step": {"@id": "pplan:correspondsToStep", "@type": "@id"},
    "plan_variable": {"@id": "pplan:correspondsToVariable", "@type": "@id"},
    "started_at": {"@id": "prov:startedAtTime", "@type": "xsd:dateTime"},
    "ended_at": {"@id": "prov:endedAtTime", "@type": "xsd:dateTime"}
  }
}
