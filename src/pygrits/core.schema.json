        "EvidenceLabel": {
            "description": "How a claim relates to its evidence. One axis, four values.",
            "enum": [
                "direct",
                "derived",
                "inferred",
                "unknown"
            ],
            "title": "EvidenceLabel",
            "type": "string"
        },
        "EvidenceLink": {
            "additionalProperties": false,
            "description": "A labelled edge from an Entity to an EvidenceRecord. The label lives here, not on the record, because one record can support a claim directly and another only by inference.",
            "properties": {
                "evidence_id": {
                    "pattern": "^[a-z]+:[A-Za-z0-9._:-]+$",
                    "type": "string"
                },
                "label": {
                    "$ref": "#/$defs/EvidenceLabel"
                },
                "rationale": {
                    "description": "Required when label is derived or inferred. Enforce in a validator, not in the schema.",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "evidence_id",
                "label"
            ],
            "title": "EvidenceLink",
            "type": "object"
        },
