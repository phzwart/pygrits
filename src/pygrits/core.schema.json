{
    "$defs": {
        "Activity": {
            "additionalProperties": false,
            "description": "Hyperedge. Consumes Entities/EvidenceRecords, may emit Entities.",
            "properties": {
                "activity_type": {
                    "$ref": "#/$defs/ActivityType"
                },
                "agent": {
                    "description": "Software or person that produced this node (name+version, or ORCID).",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "caveats": {
                    "description": "Optional free-text limits on use. Not a substitute for typed slots.",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "confidence": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Confidence"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "content_hash": {
                    "description": "Excluded from canonical bytes.",
                    "pattern": "^[a-f0-9]{64}$",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "created_at": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "ended_at": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "generated_by": {
                    "description": "Activity that produced this node, if any.",
                    "pattern": "^[a-z]+:[A-Za-z0-9._:-]+$",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "id": {
                    "pattern": "^[a-z]+:[A-Za-z0-9._:-]+$",
                    "type": "string"
                },
                "inputs": {
                    "items": {
                        "pattern": "^[a-z]+:[A-Za-z0-9._:-]+$",
                        "type": "string"
                    },
                    "type": "array"
                },
                "outputs": {
                    "items": {
                        "pattern": "^[a-z]+:[A-Za-z0-9._:-]+$",
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "plan_step": {
                    "description": "Type-level step this activity executes, when a plan graph exists.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "rationale": {
                    "description": "Why this activity is admissible given its inputs and viewpoint.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "review_state": {
                    "$ref": "#/$defs/ReviewState"
                },
                "scope": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/NotesOnlyScope"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "started_at": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "viewpoint_id": {
                    "description": "ViewpointDirective that shaped this node.",
                    "pattern": "^[a-z]+:[A-Za-z0-9._:-]+$",
                    "type": "string"
                }
            },
            "required": [
                "activity_type",
                "inputs",
                "id",
                "viewpoint_id"
            ],
            "title": "Activity",
            "type": "object"
        },
        "ActivityType": {
            "description": "Role of an Activity edge. Four values, no more.",
            "enum": [
                "derivation",
                "support",
                "contradiction",
                "adjudication"
            ],
            "title": "ActivityType",
            "type": "string"
        },
        "BboxLocator": {
            "additionalProperties": false,
            "description": "",
            "properties": {
                "bbox_x0": {
                    "type": "number"
                },
                "bbox_x1": {
                    "type": "number"
                },
                "bbox_y0": {
                    "type": "number"
                },
                "bbox_y1": {
                    "type": "number"
                },
                "locator_type": {
                    "enum": [
                        "BboxLocator"
