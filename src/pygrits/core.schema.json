                    ]
                },
                "derived_from": {
                    "items": {
                        "pattern": "^[a-z]+:[A-Za-z0-9._:-]+$",
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "evidence": {
                    "description": "Labelled links to EvidenceRecords.",
