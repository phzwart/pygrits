                    "enum": [
                        "CharRangeLocator"
                    ],
                    "type": "string"
                },
                "page": {
                    "type": [
                        "integer",
                        "null"
                    ]
                }
            },
            "required": [
                "char_start",
                "char_end",
                "locator_type"
            ],
            "title": "CharRangeLocator",
            "type": "object"
        },
        "CompositeLocator": {
            "additionalProperties": false,
            "description": "",
            "properties": {
                "locator_type": {
                    "enum": [
                        "CompositeLocator"
                    ],
                    "type": "string"
                },
                "members": {
                    "items": {
                        "anyOf": [
                            {
                                "$ref": "#/$defs/CharRangeLocator"
                            },
                            {
                                "$ref": "#/$defs/LineRangeLocator"
                            },
                            {
                                "$ref": "#/$defs/BboxLocator"
                            },
                            {
                                "$ref": "#/$defs/TableCellLocator"
                            },
                            {
                                "$ref": "#/$defs/SequencePositionLocator"
                            },
                            {
                                "$ref": "#/$defs/FileRegionLocator"
                            },
                            {
                                "$ref": "#/$defs/CompositeLocator"
                            }
                        ]
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                }
            },
            "required": [
                "locator_type"
            ],
            "title": "CompositeLocator",
            "type": "object"
        },
        "Confidence": {
            "additionalProperties": false,
            "description": "",
            "properties": {
                "calibration_scope": {
                    "type": [
                        "string",
                        "null"
                    ]
