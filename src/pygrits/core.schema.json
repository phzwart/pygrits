                    "type": [
                        "array",
                        "null"
                    ]
                },
                "generated_by": {
                    "description": "Activity that produced this node, if any.",
                    "pattern": "^[a-z]+:[A-Za-z0-9._:-]+$",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "id": {
                    "pattern": "^[a-z]+:[A-Za-z0-9._:-]+$",
                    "type": "string"
                },
                "plan_variable": {
                    "description": "Type-level variable this entity instantiates, when a plan graph exists.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "review_state": {
                    "$ref": "#/$defs/ReviewState"
