                "uri": {
                    "type": "string"
                }
            },
            "required": [
                "uri",
                "sha256",
                "hash_mode"
            ],
            "title": "ContentReference",
            "type": "object"
        },
        "Entity": {
            "additionalProperties": false,
            "description": "A subject node \u2014 a claim, a document, a measurement, a plan element. Domain schemas subclass this with typed slots. Formerly Object.",
