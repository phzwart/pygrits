{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pygrits/schema.json",
  "title": "pygrits bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["@context", "@graph"],
  "properties": {
    "@context": true,
    "@graph": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/plan"},
          {"$ref": "#/$defs/entity"},
          {"$ref": "#/$defs/activity"}
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+:[A-Za-z0-9._:-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"type": "string"}
      }
    },
    "selector": {
      "type": "object",
      "required": ["@type"],
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["@type", "exact"],
          "properties": {
            "@type": {"const": "oa:TextQuoteSelector"},
            "exact": {"type": "string"},
            "prefix": {"type": "string"},
            "suffix": {"type": "string"}
          }
        },
        {
          "additionalProperties": false,
          "required": ["@type", "start", "end"],
          "properties": {
            "@type": {"enum": ["oa:TextPositionSelector", "oa:DataPositionSelector"]},
            "start": {"type": "integer", "minimum": 0},
            "end": {"type": "integer", "minimum": 0}
          }
        },
        {
          "additionalProperties": false,
          "required": ["@type", "value"],
          "properties": {
            "@type": {"const": "oa:FragmentSelector"},
            "value": {"type": "string"},
            "conformsTo": {"type": "string"}
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector"],
      "properties": {
        "hasSource": {"type": "string"},
        "selector": {"$ref": "#/$defs/selector"}
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["@id", "@type", "name", "prompt_digest", "schema_digest"],
      "properties": {
        "@id": {"$ref": "#/$defs/id"},
        "@type": {"const": "prov:Plan"},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "agent": {"type": "string"},
        "name": {"type": "string"},
        "prompt_digest": {"$ref": "#/$defs/sha256"},
        "schema_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["@id", "@type", "plan"],
      "properties": {
        "@id": {"$ref": "#/$defs/id"},
        "@type": {"const": "prov:Entity"},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "agent": {"type": "string"},
        "plan": {"$ref": "#/$defs/id"},
        "source": {"$ref": "#/$defs/contentRef"},
        "target": {"$ref": "#/$defs/target"},
        "how": {"enum": ["quote", "derived", "inferred", "unknown"]},
        "rationale": {"type": "string"},
        "result": {"enum": ["absent", "weak", "excluded", "inconclusive"]},
        "payload": {"type": "string"},
        "payload_ref": {"$ref": "#/$defs/contentRef"},
        "plan_variable": {"type": "string"},
        "summary": {"type": "string"}
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["@id", "@type", "plan", "kind", "used"],
      "properties": {
        "@id": {"$ref": "#/$defs/id"},
        "@type": {"const": "prov:Activity"},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "performed_by": {"type": "string"},
        "plan": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["derivation", "support", "contradiction", "adjudication"]},
        "used": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/id"}
        },
        "generated": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"}
        },
        "rationale": {"type": "string"},
        "started_at": {"type": "string"},
        "ended_at": {"type": "string"},
        "plan_step": {"type": "string"}
      }
    }
  }
}
